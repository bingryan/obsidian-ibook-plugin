{
  "compilerOptions": {
	"paths": {
		"@/*": ["./src/*"]
	},
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
	"strictNullChecks": true,
	"allowSyntheticDefaultImports": true,
	"types": ["node"],
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": ["node_modules"]
}
